{
  "actors": [
    "operator",
    "manager",
    "auditor"
  ],
  "permissions": {
    "operator": [
      "register_invoice:execute"
    ],
    "manager": [
      "reconcile_payment:execute"
    ],
    "auditor": [
      "inspect_audit:execute"
    ]
  },
  "deny_by_default": true,
  "audit_events": [
    "register_invoice.completed",
    "reconcile_payment.completed",
    "inspect_audit.completed"
  ]
}
