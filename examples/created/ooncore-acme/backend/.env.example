# Identidade
SERVICE_NAME=ooncore-acme
SERVICE_VERSION=0.1.0
PORT=4000
NODE_ENV=development
OON_RUNTIME_MODE=local

# Banco
MONGO_URI=mongodb://localhost:27017/ooncore-acme

APP_CODE=ooncore-acme

# O runtime local cria uma sessão aleatória por 30 dias e escuta apenas em loopback.
# Não configure credenciais, URLs ou tokens da plataforma neste arquivo.
